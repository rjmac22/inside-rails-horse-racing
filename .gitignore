# Source and generated data
/data/raw/*
/data/interim/*
/data/processed/*
/data/external/*
/db/*

# Keep directory structure
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/data/external/.gitkeep
!/db/.gitkeep

# Bounded authoritative external evidence retained for reproducibility
!/data/external/bha/
!/data/external/bha/gb_race_population_completeness/
!/data/external/bha/gb_race_population_completeness/2026/
!/data/external/bha/gb_race_population_completeness/2026/*.pdf
!/data/external/bha/gb_race_population_completeness/2026/*.xlsx
!/data/external/bha/gb_race_population_completeness/2026/*.json
!/data/external/bha/gb_race_population_completeness/2026/*.md

# Database and large data files
*.sqlite
*.sqlite3
*.db
*.csv
*.csv.gz
*.parquet
*.feather
*.pkl
*.zip
*.7z
*.tar
*.tar.gz

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary research caches
/data/cache/

# Curated project reference data
!/data/reference/
!/data/reference/*.csv

.env.local
